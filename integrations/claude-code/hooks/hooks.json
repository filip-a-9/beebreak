{
  "description": "Breakroom activity events (metadata only, fail-open)",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../../.venv/bin/python -m breakroom_agent_bridge.hook", "async": true, "timeout": 2 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../../.venv/bin/python -m breakroom_agent_bridge.hook", "async": true, "timeout": 2 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../../.venv/bin/python -m breakroom_agent_bridge.hook", "async": true, "timeout": 2 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../../.venv/bin/python -m breakroom_agent_bridge.hook", "async": true, "timeout": 2 }] }],
    "TaskCreated": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../../.venv/bin/python -m breakroom_agent_bridge.hook", "async": true, "timeout": 2 }] }],
    "TaskCompleted": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../../.venv/bin/python -m breakroom_agent_bridge.hook", "async": true, "timeout": 2 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../../.venv/bin/python -m breakroom_agent_bridge.hook", "async": true, "timeout": 2 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../../.venv/bin/python -m breakroom_agent_bridge.hook", "async": true, "timeout": 2 }] }]
  }
}
