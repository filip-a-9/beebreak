# Copy to .env (ignored by version control) and replace the placeholders.
# Make each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# token_urlsafe output is safe inside the database URL; keep it that way.
# The server refuses to start while POSTGRES_PASSWORD is still "change-me".

POSTGRES_PASSWORD=change-me
BEEBREAK_SERVER_SECRET=change-me

# --- compose.prod.yaml only (all required there) ---
# DNS name that points at this host; Caddy gets its certificate for it.
BEEBREAK_PUBLIC_HOST=chat.example.com
# Email codes: set the SMTP values below. For a GitHub-only server leave
# BEEBREAK_SMTP_HOST empty (compose.prod.yaml then needs no SMTP values).
BEEBREAK_SMTP_HOST=smtp.example.com
BEEBREAK_SMTP_PORT=587
BEEBREAK_SMTP_USERNAME=change-me-user
BEEBREAK_SMTP_PASSWORD=change-me-too
# none | starttls (port 587) | implicit (port 465). Credentials need starttls or
# implicit. BEEBREAK_SMTP_STARTTLS=1 still works as an alias for one release.
BEEBREAK_SMTP_TLS=starttls
BEEBREAK_MAIL_FROM="Beebreak <no-reply@chat.example.com>"

# GitHub sign-in (see docs/RUNBOOK.md): the Client ID of an OAuth App with
# Device Flow enabled. Not a secret. Empty = GitHub sign-in off. The server
# needs at least one of this and BEEBREAK_SMTP_HOST.
BEEBREAK_GITHUB_CLIENT_ID=

# --- server tunables (compose.prod.yaml passes these through via env_file;
# its own pinned values, such as BEEBREAK_TRUSTED_PROXIES, win) ---
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# Empty (the default) trusts none. compose.prod.yaml sets it for Caddy itself.
# BEEBREAK_TRUSTED_PROXIES=
# Limits, shown with their defaults (all positive integers):
# BEEBREAK_MAX_PAGE=100              messages per history page
# BEEBREAK_EXTENSION_ATTEMPTS=4      retries of a chat-extension action
# BEEBREAK_MAX_BODY_BYTES=16384      request body cap
# BEEBREAK_PURGE_INTERVAL_S=60       minimum gap between purge passes
# BEEBREAK_WS_MAX_MESSAGE_BYTES=8192 largest WebSocket frame uvicorn accepts
# BEEBREAK_WS_MAX_CONNECTIONS=500    open realtime sockets before new ones are refused
# BEEBREAK_RATE_WS_CONNECT_IP=120    /v1/realtime connects per address per window
# BEEBREAK_WS_FLOOD_FRAMES=20        client frames per flood window before 4429
# BEEBREAK_WS_FLOOD_WINDOW_S=10      the flood window, seconds (a number)
# BEEBREAK_WS_OUTBOUND_MAX=64        frames queued per socket before 4429
# BEEBREAK_LAST_SEEN_INTERVAL_S=60   minimum gap between last_seen_at writes
# BEEBREAK_SMTP_TIMEOUT_S=10         SMTP connect/send timeout (a number)
# BEEBREAK_RATE_MESSAGES_READ_USER=300  history reads per user per window
# BEEBREAK_RATE_ME_READ_USER=120     GET /v1/me per user per window
# BEEBREAK_RATE_ME_WRITE_USER=30     PATCH /v1/me and PUT /v1/me/consent per window
# BEEBREAK_REFRESH_GRACE_S=90        a rotated refresh token is accepted again

# --- companion (the machine running Claude Code) ---
# PEM file of a private CA to trust instead of the system store (LAN test with
# Caddy's `tls internal`). Must not be group- or world-writable.
# BEEBREAK_CA_FILE=/home/you/.config/beebreak/caddy-root.crt
